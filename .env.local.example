# Public Supabase project URL (safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only service role key — never expose as NEXT_PUBLIC_*
# Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optional: shared pooler (transaction mode, port 6543).
# Percent-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
